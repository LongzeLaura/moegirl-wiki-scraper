# -*- coding: utf-8 -*-
"""
Pywikibot password file for Moegirlpedia (萌娘百科).

# ===========================================================================
# IMPORTANT — 安全警告
# ===========================================================================
#
# 1. 将此文件复制为 user-password.py
#    cp user-password.py.example user-password.py
#
# 2. 填入你的凭据（见下方两种方式）。
#
# 3. 保护文件权限：
#    - Linux/macOS:  chmod 600 user-password.py
#    - Windows:      右键 → 属性 → 安全 → 仅允许自己的账户读取
#
# 4. 千万不要将 user-password.py 提交到 Git！
#    .gitignore 中应包含: user-password.py
#
# ===========================================================================

# ---------------------------------------------------------------------------
# 方式 A: Bot 密码（推荐 ✅）
# ---------------------------------------------------------------------------
# 使用专用 bot 密码，不会暴露主账号密码，可以随时在网页端吊销。
#
# 创建步骤:
#   1. 浏览器登录 https://zh.moegirl.org.cn
#   2. 访问 Special:BotPasswords（https://zh.moegirl.org.cn/Special:BotPasswords）
#   3. 填写:
#      - Bot 名称:     pwb  (或任意你喜欢的名字)
#      - 权限:         勾选「读取页面」「编辑已保护页面」等需要的权限
#                      如果只做只读抓取，只需勾选「读取页面」
#   4. 点击「创建」，记下生成的 bot 密码（形如 xxxxxxxxxxxxxxxxxxxx）
#   5. 将下面的 YourMainUsername 替换为你的主账号名
#   6. 将 BotPassword 的第一个参数改为你填写的 Bot 名称（如 'pwb'）
#   7. 将第二个参数改为生成的密码字符串
#
# 格式: ('主账号用户名', BotPassword('bot名称', '生成的密码字符串'))

# ('YourMainUsername', BotPassword('pwb', 'your_bot_password_here'))


# ---------------------------------------------------------------------------
# 方式 B: 主账号密码（简单但不推荐 ⚠️）
# ---------------------------------------------------------------------------
# 直接使用你的萌娘百科登录密码。风险较高，仅用于测试。

# ('YourUsername', 'your_password_here')


# ---------------------------------------------------------------------------
# 多语言/多站点（如果将来需要）
# ---------------------------------------------------------------------------
# 可以为不同站点指定不同密码:
#   ('mgp', 'mgp', 'YourUsername', 'your_password')
#   ('mgp', 'mgp', 'YourUsername', BotPassword('botname', 'bot_password'))
